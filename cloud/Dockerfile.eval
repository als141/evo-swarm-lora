# 評価・進化ジョブ用イメージ (Vertex AI Custom Job / Spot A100 想定)
# vLLM OpenAI 互換サーバ + 本リポジトリの評価/進化ドライバを同梱する。
# 既定は Qwen3-4B-Instruct-2507 の公式推奨最低版 (v0.8.5)。
# 最新版は --build-arg VLLM_TAG=v0.24.0-ubuntu2404 等で差し替え可能。
ARG VLLM_TAG=v0.8.5
FROM vllm/vllm-openai:${VLLM_TAG}

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/workspace/.cache/huggingface \
    PYTHONPATH=/workspace

# ドライバが必要とする軽量依存のみ追加（torch/transformers/openai は同梱済み）
RUN pip install --no-cache-dir "datasets>=3.0.0" "httpx>=0.27.0"

# Vertex ホストのドライバは CUDA 12.2 相当（535系）で、vLLM の torch は cu124+ ビルド。
# データセンタ GPU (A100/T4) 向けの CUDA forward-compat ライブラリを導入し、
# entrypoint で LD_LIBRARY_PATH=/usr/local/cuda/compat を有効化する。
RUN apt-get update && apt-get install -y --no-install-recommends cuda-compat-12-4 \
    && rm -rf /var/lib/apt/lists/* || echo "WARNING: cuda-compat install failed"

WORKDIR /workspace
COPY src ./src
COPY scripts ./scripts
COPY cloud/entrypoint_eval.sh ./cloud/entrypoint_eval.sh
RUN chmod +x ./cloud/entrypoint_eval.sh

ENTRYPOINT ["/workspace/cloud/entrypoint_eval.sh"]
